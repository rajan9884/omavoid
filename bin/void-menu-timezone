#!/bin/bash

# void:summary=Select and set the system timezone
# void:group=menu
# void:name=timezone

set -e

timezone=$(timedatectl list-timezones | void-menu-select "$(void-i18n timezone.setTitle)" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
void-shell -q void.clock refresh
void-notification-send "$(void-i18n timezone.changed "$timezone")"
