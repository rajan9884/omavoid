#!/usr/bin/env bash
# void:summary=Apply current theme to Strata file manager
# void:hidden=true

THEME_DIR="$HOME/.local/state/void/current/theme"
THEME_NAME_FILE="$HOME/.local/state/void/current/theme.name"
COLORS_FILE="$THEME_DIR/colors.toml"
STRATA_CONFIG_DIR="$HOME/.config/strata"
STRATA_THEMES_DIR="$STRATA_CONFIG_DIR/themes"
STRATA_SETTINGS="$STRATA_CONFIG_DIR/settings.toml"

[[ -f "$COLORS_FILE" ]] || exit 0

theme_name=$(cat "$THEME_NAME_FILE" 2>/dev/null || echo "system")
theme_id=$(echo "$theme_name" | tr '[:upper:]' '[:lower:]' | tr ' ' '-')

# 1. Maintain Omarchy compatibility symlink & version for native strata integration
mkdir -p "$HOME/.local/share/omarchy"
echo "3.0.0" > "$HOME/.local/share/omarchy/version"
ln -sfn "$HOME/.local/state/void" "$HOME/.local/state/omarchy"

# 2. Parse colors from colors.toml
eval "$(awk -F '=' '
  /^[[:space:]]*[a-zA-Z0-9_]+[[:space:]]*=/ {
    key = $1; gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
    val = $2; gsub(/^[[:space:]]+|[[:space:]]+$|"/, "", val)
    printf "COLOR_%s=\"%s\"\n", key, val
  }
' "$COLORS_FILE")"

bg="${COLOR_background:-#121212}"
surface="${COLOR_lighter_background:-#1e1e1e}"
text="${COLOR_foreground:-#bebebe}"
accent="${COLOR_accent:-#e68e0d}"
danger="${COLOR_red:-#D35F5F}"
muted="${COLOR_muted:-#333333}"
highlight="${COLOR_selection:-#2a2a2a}"
border="${COLOR_muted:-#333333}"
dim_text="${COLOR_light_foreground:-#8a8a8d}"
syn_keyword="${COLOR_magenta:-#D35F5F}"
syn_string="${COLOR_green:-#FFC107}"
syn_constant="${COLOR_yellow:-#b91c1c}"
syn_type="${COLOR_cyan:-#bebebe}"
syn_preproc="${COLOR_blue:-#e68e0d}"

# 3. Generate Strata theme TOML files
mkdir -p "$STRATA_THEMES_DIR"

generate_theme_file() {
  local file_path="$1"
  local id="$2"
  local name="$3"

  cat > "$file_path" <<EOF
id = "$id"
name = "$name"
background = "$bg"
surface = "$surface"
text = "$text"
accent = "$accent"
danger = "$danger"
muted = "$muted"
highlight = "$highlight"
border = "$border"
dim_text = "$dim_text"
syntax_keyword = "$syn_keyword"
syntax_string = "$syn_string"
syntax_constant = "$syn_constant"
syntax_type = "$syn_type"
syntax_preprocessor = "$syn_preproc"
EOF
}

generate_theme_file "$STRATA_THEMES_DIR/system.toml" "system" "System"
if [[ -n "$theme_id" && "$theme_id" != "system" ]]; then
  generate_theme_file "$STRATA_THEMES_DIR/$theme_id.toml" "$theme_id" "$theme_name"
fi

# 4. Update Strata settings to follow current theme
if [[ -f "$STRATA_SETTINGS" ]]; then
  if grep -q '^[[:space:]]*theme[[:space:]]*=' "$STRATA_SETTINGS"; then
    sed -i -E "s/^[[:space:]]*theme[[:space:]]*=.*/theme = \"$theme_id\"/" "$STRATA_SETTINGS"
  else
    echo "theme = \"$theme_id\"" >> "$STRATA_SETTINGS"
  fi
fi

# 5. Generate GTK4 CSS for Libadwaita / GTK4 styling consistency
mkdir -p "$HOME/.config/gtk-4.0"
cat > "$HOME/.config/gtk-4.0/gtk.css" <<EOF
/* Generated by void-theme-set-strata */
@define-color accent_color $accent;
@define-color accent_bg_color $accent;
@define-color accent_fg_color $bg;
@define-color window_bg_color $bg;
@define-color window_fg_color $text;
@define-color view_bg_color $bg;
@define-color view_fg_color $text;
@define-color headerbar_bg_color $bg;
@define-color headerbar_fg_color $text;
@define-color card_bg_color $surface;
@define-color card_fg_color $text;
@define-color dialog_bg_color $surface;
@define-color dialog_fg_color $text;
@define-color popover_bg_color $surface;
@define-color popover_fg_color $text;
@define-color dark_1 $bg;
@define-color dark_2 $surface;
@define-color dark_3 $muted;
EOF
