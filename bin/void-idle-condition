#!/usr/bin/env bash

# void-idle-condition: Check if system idle actions (dim, screensaver, lock, suspend) are permitted.
# Exit 0 if idle is permitted.
# Exit 1 (or >0) if idle is inhibited (stay-awake active, audio playing, mic recording, or fullscreen app).

# 1. Stay-awake manual indicator toggle
if [[ -f "$HOME/.local/state/void/indicators/stay-awake" ]]; then
  exit 1
fi

# 2. Audio is playing (e.g. video in browser, mpv, Spotify, media player)
if pactl list sinks 2>/dev/null | grep -q "State: RUNNING"; then
  exit 1
fi

# 2b. MPRIS media player is actively playing
if command -v playerctl >/dev/null 2>&1; then
  if playerctl status 2>/dev/null | grep -qi "Playing"; then
    exit 1
  fi
fi

# 3. Audio input stream is active (e.g. microphone in use for call or recording)
if [[ -n $(pactl list source-outputs short 2>/dev/null) ]]; then
  exit 1
fi

# 4. Active window is fullscreen (excluding screensaver so lock can engage after screensaver)
if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  active_class=$(hyprctl activewindow -j 2>/dev/null | jq -r '.class // empty')
  active_fullscreen=$(hyprctl activewindow -j 2>/dev/null | jq -r '.fullscreen // 0')
  if [[ "$active_fullscreen" != "0" && "$active_class" != "org.void.screensaver" ]]; then
    exit 1
  fi
fi

# System is idle and not inhibited
exit 0
