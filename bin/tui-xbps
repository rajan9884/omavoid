#!/usr/bin/env bash
set -euo pipefail

pkg=$(xbps-query -Rs "" | fzf --prompt="Void XBPS > " --reverse \
    --header="Enter: Install Package | ESC: Exit" \
    --preview="xbps-query -R {2}" \
    --preview-window="right:55%:wrap" | awk '{print $2}')

if [[ -n "$pkg" ]]; then
    sudo xbps-install -S "$pkg"
    read -rp "Press Enter to close..."
fi
