#!/bin/bash

# void:summary=Open the wallpaper background switcher
# void:group=theme

: "${VOID_PATH:=/usr/share/void}"
export PATH="$VOID_PATH/bin:/usr/local/bin:/usr/bin:/usr/sbin:$PATH"

theme_name=$(cat "$HOME/.local/state/void/current/theme.name" 2>/dev/null)
current_background=$(readlink -f "$HOME/.local/state/void/current/background" 2>/dev/null)

bg=$(void-menu-images \
  --selected "$current_background" \
  "$HOME/.local/state/void/current/theme/backgrounds" \
  "$HOME/.config/void/backgrounds/$theme_name")

if [[ -n "$bg" && -f "$bg" ]]; then
  void-theme-bg-set "$bg"
fi
