#!/bin/bash

# void:summary=Restart the XCompose input method service (fcitx5) to apply new compose key settings.

set -euo pipefail

# A fcitx5 running outside the unit owns org.fcitx.Fcitx5, so the unit's
# instance would exit on arrival and the stale process would keep serving the
# old ~/.XCompose -- a restart that reports success and changes nothing.
pkill -u "$UID" -x fcitx5 >/dev/null 2>&1 || true
for attempt in {1..30}; do
  if ! pgrep -u "$UID" -x fcitx5 >/dev/null; then
    break
  fi
  sleep 0.1
done
if command -v fcitx5 >/dev/null 2>&1; then
  fcitx5 -d >/dev/null 2>&1 || true
fi
