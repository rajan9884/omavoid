#!/usr/bin/env bash
# Authentic Void audio stack initialization for Void Linux under Wayland / Hyprland
# Ensures PipeWire, WirePlumber, PipeWire-Pulse, Void speaker tuning, and Jack detection start cleanly.

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi

mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true

# Single-instance flock to avoid race conditions during login
exec 200>"$XDG_RUNTIME_DIR/void-audio-init.lock"
flock -n 200 || exit 0

# Wait up to 5 seconds for ALSA sound hardware node to be readable
for i in $(seq 1 50); do
    if [ -r /dev/snd/controlC0 ] && [ -w /dev/snd/controlC0 ]; then
        break
    fi
    udevadm trigger --subsystem-match=sound 2>/dev/null || true
    sleep 0.1
done

# Clean up any stale sockets if PipeWire is not running or not responding
if ! pw-cli info 0 >/dev/null 2>&1; then
    pkill -9 -u "$USER" -x wireplumber 2>/dev/null || true
    pkill -9 -u "$USER" -f "/usr/bin/pipewire" 2>/dev/null || true
    rm -f "$XDG_RUNTIME_DIR"/pipewire-*.lock "$XDG_RUNTIME_DIR"/pipewire-0* "$XDG_RUNTIME_DIR"/pulse/native 2>/dev/null || true
    setsid nohup /usr/bin/pipewire >/dev/null 2>&1 200>&- &
    sleep 0.5
fi

# Ensure WirePlumber is running:
for i in $(seq 1 30); do
    if pgrep -u "$USER" -x wireplumber >/dev/null 2>&1; then
        break
    fi
    sleep 0.1
done
if ! pgrep -u "$USER" -x wireplumber >/dev/null 2>&1; then
    pkill -9 -u "$USER" -x wireplumber 2>/dev/null || true
    setsid nohup /usr/bin/wireplumber >/dev/null 2>&1 200>&- &
    sleep 0.3
fi

# Ensure PipeWire-Pulse is running and responding:
for i in $(seq 1 20); do
    if pactl info >/dev/null 2>&1; then
        break
    fi
    sleep 0.1
done
if ! pactl info >/dev/null 2>&1; then
    pkill -9 -u "$USER" -f "pipewire.*pipewire-pulse.conf" 2>/dev/null || true
    setsid nohup /usr/bin/pipewire -c pipewire-pulse.conf >/dev/null 2>&1 200>&- &
    sleep 0.3
fi

# Ensure hardware ALSA mixer controls are unmuted and auto-mute enabled
if command -v amixer >/dev/null 2>&1; then
    for card in sofhdadsp 0 1; do
        amixer -c "$card" sset 'Auto-Mute Mode' 'Enabled' >/dev/null 2>&1 || true
        amixer -c "$card" cset name='Master Playback Switch' on >/dev/null 2>&1 || true
        hp_jack="$(amixer -c "$card" cget iface=CARD,name='Front Headphone Jack' 2>/dev/null | awk -F'=' '/values=/ {print $2}')"
        if [ "$hp_jack" = "on" ]; then
            amixer -c "$card" cset name='Headphone Playback Switch' on,on >/dev/null 2>&1 || true
            amixer -c "$card" cset name='Speaker Playback Switch' off,off >/dev/null 2>&1 || true
        else
            amixer -c "$card" cset name='Headphone Playback Switch' off,off >/dev/null 2>&1 || true
            amixer -c "$card" cset name='Speaker Playback Switch' on,on >/dev/null 2>&1 || true
        fi
        amixer -c "$card" cset name='Master Playback Volume' 87 >/dev/null 2>&1 || true
        amixer -c "$card" cset name='Speaker Playback Volume' 87,87 >/dev/null 2>&1 || true
        amixer -c "$card" cset name='Headphone Playback Volume' 87,87 >/dev/null 2>&1 || true
        amixer -c "$card" cset name='Dmic0 Capture Switch' on >/dev/null 2>&1 || true
        amixer -c "$card" cset name='Capture Switch' on >/dev/null 2>&1 || true
        amixer -c "$card" cset name='Capture Volume' 50,50 >/dev/null 2>&1 || true
        amixer -c "$card" cset name='Dmic0 Capture Volume' 60,60 >/dev/null 2>&1 || true
        amixer -c "$card" cset name='PGA2.0 2 Master Capture Volume' 60,60 >/dev/null 2>&1 || true
    done
fi

# Ensure default audio source is Digital Microphone if present
if command -v wpctl >/dev/null 2>&1; then
    dmic_id="$(timeout 2s wpctl status 2>/dev/null | awk '/Digital Microphone/ {gsub(/[^0-9]/, "", $1); if ($1 != "") {print $1; exit}}')"
    if [ -n "$dmic_id" ]; then
        timeout 2s wpctl set-default "$dmic_id" >/dev/null 2>&1 || true
    fi
fi
if command -v pactl >/dev/null 2>&1; then
    dmic_name="$(timeout 2s pactl list sources short 2>/dev/null | awk '/HiFi__Mic1__source/ {print $2; exit}')"
    if [ -n "$dmic_name" ]; then
        timeout 2s pactl set-default-source "$dmic_name" >/dev/null 2>&1 || true
    fi
fi

# Ensure dynamic headphone jack monitor is running in background
if command -v void-audio-jack-monitor >/dev/null 2>&1; then
    setsid nohup void-audio-jack-monitor >/dev/null 2>&1 200>&- &
fi

