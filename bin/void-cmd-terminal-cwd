#!/bin/bash

# void:summary=Resolve current working directory for active terminal or pid
# void:args=[pid]

pid="${1:-}"

if [[ -z "$pid" && -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && command -v hyprctl &>/dev/null && command -v jq &>/dev/null; then
  pid=$(hyprctl activewindow -j 2>/dev/null | jq -r '.pid // empty')
fi

[[ -n "$pid" && "$pid" =~ ^[0-9]+$ ]] || { echo "$HOME"; exit 0; }
[[ -d "/proc/$pid" ]] || { echo "$HOME"; exit 0; }

# 1. Check file managers (thunar, nautilus, folio, nemo, pcmanfm)
exe=$(readlink -f "/proc/$pid/exe" 2>/dev/null)
if [[ $exe == */thunar || $exe == */nautilus || $exe == */folio || $exe == */nemo || $exe == */pcmanfm* ]]; then
  fcwd=$(readlink -f "/proc/$pid/cwd" 2>/dev/null)
  if [[ -d "$fcwd" && "$fcwd" != "/" ]]; then
    echo "$fcwd"
    exit 0
  fi
fi

# 2. Check kitty socket if kitty is the terminal
kitty_socket="$XDG_RUNTIME_DIR/kitty-$pid"
[[ ! -S $kitty_socket ]] && kitty_socket="$XDG_RUNTIME_DIR/omarchy-kitty-$pid"
if [[ -S $kitty_socket ]] && command -v kitten &>/dev/null; then
  kcwd=$(kitten @ --to "unix:$kitty_socket" ls --match "state:focused" 2>/dev/null | jq -r '.[].tabs[].windows[].cwd // empty' 2>/dev/null)
  if [[ -d "$kcwd" ]]; then
    echo "$kcwd"
    exit 0
  fi
fi

# 3. Gather all descendant processes (BFS)
queue=("$pid")
all_pids=()
while (( ${#queue[@]} > 0 )); do
  curr="${queue[0]}"
  queue=("${queue[@]:1}")
  task_dir="/proc/$curr/task"
  [[ -d "$task_dir" ]] || continue
  for task in "$task_dir"/*; do
    children_file="$task/children"
    if [[ -r "$children_file" ]]; then
      read -ra children < "$children_file" 2>/dev/null || true
      for child in "${children[@]}"; do
        all_pids+=("$child")
        queue+=("$child")
      done
    fi
  done
done

# 4. If herdr is running in this process tree, query herdr for the focused pane cwd
has_herdr=false
for p in "${all_pids[@]}"; do
  if [[ $(cat "/proc/$p/comm" 2>/dev/null) == "herdr"* ]]; then
    has_herdr=true
    break
  fi
done

if $has_herdr && command -v herdr &>/dev/null && command -v jq &>/dev/null; then
  herdr_cwd=$(herdr pane list 2>/dev/null | jq -r '.result.panes[] | select(.focused == true) | .foreground_cwd // .cwd // empty' 2>/dev/null)
  if [[ -d "$herdr_cwd" && "$herdr_cwd" != "/" ]]; then
    echo "$herdr_cwd"
    exit 0
  fi
fi

# 5. If tmux is running in this process tree, query tmux active pane
has_tmux=false
for p in "${all_pids[@]}"; do
  if [[ $(cat "/proc/$p/comm" 2>/dev/null) == "tmux"* ]]; then
    has_tmux=true
    break
  fi
done

if $has_tmux && command -v tmux &>/dev/null; then
  tcwd=$(tmux display-message -p -F "#{pane_current_path}" 2>/dev/null)
  if [[ -d "$tcwd" && "$tcwd" != "/" ]]; then
    echo "$tcwd"
    exit 0
  fi
fi

# 6. Look for shell or editor processes among descendants in reverse order (newest first)
for (( i=${#all_pids[@]}-1; i>=0; i-- )); do
  p="${all_pids[i]}"
  pcomm=$(cat "/proc/$p/comm" 2>/dev/null)
  case "$pcomm" in
    zsh|bash|fish|sh|ksh|csh|tcsh|dash|nvim|vim|nano|hx|helix|micro|yazi|lf|ranger)
      pcwd=$(readlink -f "/proc/$p/cwd" 2>/dev/null)
      if [[ -d "$pcwd" && "$pcwd" != "/" ]]; then
        echo "$pcwd"
        exit 0
      fi
      ;;
  esac
done

# 7. Fallback: check any descendant with a valid cwd != "/"
for (( i=${#all_pids[@]}-1; i>=0; i-- )); do
  p="${all_pids[i]}"
  pcwd=$(readlink -f "/proc/$p/cwd" 2>/dev/null)
  if [[ -d "$pcwd" && "$pcwd" != "/" ]]; then
    echo "$pcwd"
    exit 0
  fi
done

# 8. Fallback to direct pid cwd if valid and != "/"
tcwd=$(readlink -f "/proc/$pid/cwd" 2>/dev/null)
if [[ -d "$tcwd" && "$tcwd" != "/" ]]; then
  echo "$tcwd"
  exit 0
fi

echo "$HOME"
