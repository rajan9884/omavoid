#!/bin/bash

# void:summary=Toggle nightlight screen temperature (runs hyprsunset on-demand)
# void:args=[--status]
# void:examples=void toggle nightlight

ON_TEMP=4000
IDENTITY_TEMP=6000

current_temp() {
  local output

  output=$(hyprctl hyprsunset temperature 2>/dev/null) || return
  grep -oE '[0-9]+' <<<"$output" | head -n1
}

status_json() {
  local temp enabled

  temp=$(current_temp)
  if [[ -n $temp ]] && (( temp < IDENTITY_TEMP )); then
    enabled=true
  else
    enabled=false
  fi

  jq -cn --argjson enabled "$enabled" --arg temp "$temp" \
    '{enabled:$enabled, temperature:(($temp | tonumber?) // null)}'
}

if [[ ${1:-} == "--status" ]]; then
  status_json
  exit 0
fi

if pgrep -x hyprsunset >/dev/null; then
  # Already running: turn OFF and terminate hyprsunset completely
  pkill -x hyprsunset 2>/dev/null || true
else
  # Not running: turn ON on demand
  setsid uwsm-app -- hyprsunset >/dev/null 2>&1 &
  for _ in {1..10}; do
    hyprctl hyprsunset temperature $ON_TEMP >/dev/null 2>&1
    [[ $(current_temp) == "$ON_TEMP" ]] && break
    sleep 0.2
  done
fi

void-shell -q nightlight refresh 2>/dev/null || true
