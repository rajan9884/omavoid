#!/bin/bash

# void:summary=Edit, set, or reset screensaver branding
# void:group=branding
# void:name=screensaver
# void:args=<image|text|reset>
# void:examples=void branding screensaver image | void branding screensaver text | void branding screensaver reset

set -euo pipefail

case "${1:-}" in
image)
  image=$(void-file-select --title "$(void-i18n branding.pickScreensaverImage)" --extensions "png svg")
  if void-transcode-ascii "$image" ~/.config/void/branding/screensaver.txt; then
    void-launch-screensaver force >/dev/null 2>&1
  fi
  ;;
text)
  void-launch-editor ~/.config/void/branding/screensaver.txt >/dev/null 2>&1 && void-launch-screensaver force >/dev/null 2>&1
  ;;
reset)
  cp "$VOID_PATH/logo.txt" ~/.config/void/branding/screensaver.txt && void-launch-screensaver force >/dev/null 2>&1
  ;;
*)
  echo "Usage: void-branding-screensaver <image|text|reset>" >&2
  exit 1
  ;;
esac
