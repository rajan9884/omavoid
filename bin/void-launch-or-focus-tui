#!/bin/bash

# void:summary=Launch a TUI or focus an existing terminal window for it
# void:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.void.$(basename "$1")"
fi

LAUNCH_COMMAND="void-launch-tui $@"

exec void-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
