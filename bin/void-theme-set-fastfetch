#!/usr/bin/env bash
# void:summary=Apply current theme to fastfetch
# void:hidden=true

THEME_FILE="$HOME/.local/state/void/current/theme/fastfetch.jsonc"
FASTFETCH_DIR="$HOME/.config/fastfetch"

mkdir -p "$FASTFETCH_DIR"
if [[ -f "$THEME_FILE" ]]; then
  cp "$THEME_FILE" "$FASTFETCH_DIR/config.jsonc"
  # Also keep repo copy in sync if different
  REPO_CONF="$HOME/omavoid/config/fastfetch/config.jsonc"
  if [[ -f "$REPO_CONF" && "$(readlink -f "$FASTFETCH_DIR/config.jsonc" 2>/dev/null)" != "$(readlink -f "$REPO_CONF" 2>/dev/null)" ]]; then
    cp "$THEME_FILE" "$REPO_CONF"
  fi
fi
