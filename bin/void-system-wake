#!/usr/bin/env bash

# void-system-wake: Wake displays and restore backlight after lock/idle
# void:summary=Wake displays and restore brightness after idle
# void:group=system
# void:name=wake
# void:examples=void-system-wake

void-brightness-display on >/dev/null 2>&1 || true
void-brightness-keyboard restore >/dev/null 2>&1 || true

# Dismiss screensaver if running
pkill -x ttfx 2>/dev/null || true
pkill -f 'org\.(void|omarchy)\.screensaver' 2>/dev/null || true
hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null || hyprctl keyword cursor:invisible false &>/dev/null || true
