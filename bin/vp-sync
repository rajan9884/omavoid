#!/usr/bin/env bash
# Wrapper for void-packages custom sync and build tool

VP_DIR="${XBPS_DISTDIR:-${HOME}/.local/share/pkg/void-packages}"

if [ ! -d "$VP_DIR" ]; then
    echo "Error: void-packages directory not found at $VP_DIR" >&2
    exit 1
fi

export XBPS_DISTDIR="$VP_DIR"
exec "$VP_DIR/vp-sync" "$@"
