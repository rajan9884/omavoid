{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "source": "void",
    "padding": {
      "right": 1
    }
  },

  "display": {
    "separator": "     ➜     ",
    "key": {
      "width": 24
    }
  },

  "modules": [
    {
      "type": "title"
    },
    "separator",

    {
      "type": "custom",
      "format": "\u001b[1;38;2;181,151,144m╭─────────────────────── SYSTEM ──────────────────────╮\u001b[0m"
    },
    {
      "type": "os",
      "key": " OS        ",
      "keyColor": "#b59790"
    },
    {
      "type": "host",
      "key": "󰌢 Host      ",
      "keyColor": "#b59790"
    },
    {
      "type": "kernel",
      "key": "󰌽 Kernel    ",
      "keyColor": "#b59790"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime    ",
      "keyColor": "#b59790"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages  ",
      "keyColor": "#b59790"
    },
    {
      "type": "shell",
      "key": " Shell     ",
      "keyColor": "#b59790"
    },
    {
      "type": "custom",
      "format": "\u001b[1;38;2;181,151,144m╰─────────────────────────────────────────────────────╯\u001b[0m"
    },

    {
      "type": "custom",
      "format": "\u001b[1;38;2;165,160,182m╭────────────────────── DESKTOP ──────────────────────╮\u001b[0m"
    },
    {
      "type": "display",
      "key": "󰍹 Display   ",
      "keyColor": "#a5a0b6",
      "format": "{width}x{height} @ {refresh-rate} Hz {scale-factor}x {inch}''"
    },
    {
      "type": "de",
      "key": "󰘔 DE        ",
      "keyColor": "#a5a0b6"
    },
    {
      "type": "wm",
      "key": "󰖲 WM        ",
      "keyColor": "#a5a0b6"
    },
    {
      "type": "wmtheme",
      "key": "󰋜 WM Theme  ",
      "keyColor": "#a5a0b6"
    },
    {
      "type": "font",
      "key": "󰛖 Font      ",
      "keyColor": "#a5a0b6"
    },
    {
      "type": "cursor",
      "key": "󰇀 Cursor    ",
      "keyColor": "#a5a0b6"
    },
    {
      "type": "terminal",
      "key": " Terminal  ",
      "keyColor": "#a5a0b6"
    },
    {
      "type": "terminalfont",
      "key": " Term Font ",
      "keyColor": "#a5a0b6"
    },
    {
      "type": "custom",
      "format": "\u001b[1;38;2;165,160,182m╰─────────────────────────────────────────────────────╯\u001b[0m"
    },

    {
      "type": "custom",
      "format": "\u001b[1;38;2;196,216,226m╭────────────────────── HARDWARE ─────────────────────╮\u001b[0m"
    },
    {
      "type": "cpu",
      "key": " CPU       ",
      "keyColor": "#c4d8e2",
      "format": "{name} ({cores-online})"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU       ",
      "keyColor": "#c4d8e2",
      "format": "{vendor} {name} ({type})"
    },
    {
      "type": "memory",
      "key": "󰍛 Memory    ",
      "keyColor": "#c4d8e2"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk      ",
      "keyColor": "#c4d8e2"
    },
    {
      "type": "custom",
      "format": "\u001b[1;38;2;196,216,226m╰─────────────────────────────────────────────────────╯\u001b[0m"
    },

    "separator",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
