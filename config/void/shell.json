{
  "bar": {
    "background": "opaque",
    "layout": {
      "center": [
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "void.clock",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "centerBegin": [
        {
          "id": "void.indicators"
        }
      ],
      "centerEnd": [
        {
          "id": "void.weather"
        }
      ],
      "left": [
        {
          "id": "void.menu"
        },
        {
          "id": "void.workspaces"
        }
      ],
      "right": [
        {
          "id": "void.tray"
        },
        {
          "id": "void.keyboard-layout"
        },
        {
          "id": "void.bluetooth"
        },
        {
          "id": "void.network"
        },
        {
          "id": "void.audio"
        },
        {
          "id": "void.microphone"
        },
        {
          "id": "void.monitor"
        },
        {
          "id": "void.power",
          "showPercentage": true
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "dock": {
    "autohide": true,
    "pinned": [
      "firefox",
      "foot",
      "yazi",
      "mpv"
    ]
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    "void.speedtest",
    "void.wifiqr"
  ],
  "version": 1
}
